{%- set new_tab = '<span class="sr-only"> (opens in a new tab)</span>'|safe -%}
<section class="investor-opening wrap" aria-labelledby="investor-opening-title"><div class="investor-opening-copy"><p class="eyebrow">Investors &amp; partners</p><h1 id="investor-opening-title">Products today.<br><span>Possibility ahead.</span></h1><div class="investor-opening-aside"><p class="lede">4 consumer apps, and 3 SaaS products for the work behind them. Explore the products, then the company direction.</p><div class="actions">{{ investor_button|safe }}{{ partner_button|safe }}</div><div class="investor-tools"><a class="text-link investor-program-link" href="{{ program_href }}">Reviewing an application? Contact the founder <span aria-hidden="true">→</span></a><a class="text-link" href="/company#facts">Company facts <span aria-hidden="true">→</span></a><a class="text-link" href="/press">Press kit <span aria-hidden="true">→</span></a><button type="button" class="text-link print-page" data-print hidden>Print or save as PDF</button>{{ copy_link|safe }}</div>{{ index|safe }}</div></div><div class="showroom" id="portfolio"><ul class="showroom-frames" tabindex="0" aria-label="Consumer portfolio: {{ apps|length }} store-listed apps">
{%- for app in apps -%}
<li class="showroom-frame" data-product-accent="{{ app.color }}"><a class="showroom-link" href="/apps/{{ app.slug }}"><span class="showroom-window screenshot-stage"><img class="store-screen plate--window"{% if app.get('crop_focus') %} style="object-position:{{ app.crop_focus }}"{% endif %} src="/assets/{{ app.screen }}" alt="{{ app.name }} official App Store imagery with sample app content" width="{{ app.get('screen_width', 600) }}" height="{{ app.get('screen_height', 1298) }}" sizes="(max-width: 374px) 50vw, (max-width: 560px) 180px, (max-width: 1100px) 18vw, 180px"{% if loop.first %} fetchpriority="high"{% endif %} decoding="async"></span><span class="showroom-identity"><img src="/assets/{{ app.slug }}-icon.webp" width="40" height="40" alt="" loading="lazy" decoding="async"><span><strong>{{ app.name }}</strong><small>{{ app.category }}</small></span></span></a><p class="showroom-stores"><a href="{{ app.apple|attributed('investors-showroom') }}" target="_blank" rel="noopener noreferrer">App Store<span class="sr-only">: {{ app.name }}</span> <span aria-hidden="true">↗</span>{{ new_tab }}</a><a href="{{ app.google|attributed('investors-showroom') }}" target="_blank" rel="noopener noreferrer">Google Play<span class="sr-only">: {{ app.name }}</span> <span aria-hidden="true">↗</span>{{ new_tab }}</a></p></li>
{%- endfor -%}
</ul><p class="caption showroom-caption">{{ caption|safe }}</p>{{ web_apps|safe }}</div></section>
