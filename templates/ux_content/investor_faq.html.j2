<section class="investor-faq section wrap" id="investor-questions" aria-labelledby="investor-questions-title"><div class="section-heading"><div><h2 id="investor-questions-title">A few useful answers.</h2></div><p class="section-lede">A clear starting point for exploring the products, the platform, and a potential collaboration.</p><button type="button" class="text-link faq-toggle" data-answers-toggle aria-controls="investor-answers" aria-expanded="false" hidden>Show all answers</button></div><div class="faq-list" id="investor-answers">
{%- for id, question, answer in questions -%}
<details class="faq-item" id="{{ id }}"><summary><span class="faq-number" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span><span class="faq-question">{{ question|safe }}</span><span class="faq-marker" aria-hidden="true">+</span></summary><div class="faq-answer">{% if legacy.get(id) %}<span id="{{ legacy[id] }}"></span>{% endif %}{{ answer|safe }}<p class="faq-permalink"><a href="#{{ id }}">Link to this answer<span class="sr-only">: {{ question|striptags }}</span></a></p></div></details>
{%- endfor -%}
</div></section>
