<div class="founder-record">
{%- if founder.get('bio') %}<p>{{ founder.get('bio') }}</p>{% endif -%}
{%- if founder.get('why') %}<p class="founder-why">{{ founder.get('why') }}</p>{% endif -%}
{%- if founder.get('linkedin') %}<a class="text-link" href="{{ founder.get('linkedin') }}" target="_blank" rel="noopener noreferrer">Ata Turhan on LinkedIn <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>{% endif -%}
</div>
