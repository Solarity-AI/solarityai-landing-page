<footer class="site-footer chrome-footer"><div class="wrap"><nav class="footer-directory" aria-label="Footer navigation">
  {%- for heading, links in groups -%}
    <div class="footer-group"><h2>{{ heading }}</h2><ul>
    {%- for href, label in links %}
      {%- set leaves = href.startswith(('mailto:', 'https:')) %}{% set new_tab = href.startswith('https:') -%}
      <li><a href="{{ href }}"{% if href == path %} aria-current="page"{% endif %}{% if new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ label }}
      {%- if leaves %}<span aria-hidden="true">↗</span>{% endif %}{% if new_tab %}<span class="sr-only"> (opens in a new tab)</span>{% endif %}</a></li>
    {%- endfor -%}
    </ul></div>
  {%- endfor -%}
  </nav><div class="footer-signature" aria-hidden="true"><img class="footer-sun" src="/assets/brand/solarity-sun-320.2513ba060440.webp" srcset="/assets/brand/solarity-sun-192.91c59bec3b73.webp 192w, /assets/brand/solarity-sun-320.2513ba060440.webp 320w" sizes="(max-width: 560px) 56px, 13cqi" width="320" height="320" alt="" loading="lazy" decoding="async">
  {#- -#}
  <span class="footer-signature-word">SOLARITY<span>AI</span></span></div>
  {#- -#}
  <div class="footer-legal"><p>© 2026 {% if company %}{{ company }}{% else %}Solarity AI LLC{% endif %} · Irving, Texas, United States{% if updated %} · Updated <time datetime="{{ updated_iso }}">{{ updated }}</time>{% endif %} · <a href="/website-data">Website data</a> · <a href="/accessibility">Accessibility</a></p>
  {#- -#}
  <p>App Store is a trademark of Apple Inc. Google Play is a trademark of Google LLC.</p></div></div></footer>
