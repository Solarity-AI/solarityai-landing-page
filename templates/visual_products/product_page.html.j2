<div class="product-world" data-product="{{ app['slug'] }}" data-product-accent="{{ app['color'] }}">
      {{ breadcrumbs|safe }}
      <section class="product-hero wrap" aria-labelledby="product-title">
        <header class="product-hero-heading"><div class="product-identity"><img class="detail-icon" src="/assets/{{ app['slug'] }}-icon.webp" width="104" height="104" alt=""><p class="eyebrow">{{ app['category'] }}</p></div><h1 id="product-title">{{ app['name'] }}</h1><p class="product-deck">{{ app['headline'] }}</p></header>
        <div class="product-hero-art">{{ art|safe }}</div>
        <div class="product-hero-copy"><p class="lede">{{ app['intro'] }}</p><div class="product-get" id="get-app">{{ stores|safe }}</div>
          {%- if app.get('store_name') %}<p class="product-store-name">On the App Store and Google Play as {{ app['store_name'] }}.</p>{% endif %}
          {%- if app.get('apple') %}<p class="fineprint">{% if since %}On the App Store since <time datetime="{{ since_iso }}">{{ since }}</time>. {% endif %}In-app purchases. See the stores for current plans and regional availability.</p>{% endif %}</div>
      </section>
      {{ story|safe }}
      {{ feature_markup|safe }}
      {%- if app.get('factory_note') %}
      <aside class="factory-note wrap" aria-label="From the app factory"><p><strong>From the app factory.</strong> {{ app['factory_note'][0] }} <a href="{{ app['factory_note'][1] }}">{{ app['factory_note'][2] }} <span aria-hidden="true">→</span></a></p></aside>
      {%- endif %}
      <aside class="product-note wrap" aria-label="Product context"><p><strong>Product context.</strong> {{ app['note'] }}</p></aside>
      <aside class="product-note wrap" aria-label="Feedback"><p><strong>Using {{ app['name'] }}?</strong> <a href="{{ feedback_url }}" target="_blank" rel="noopener noreferrer">Share your feedback <span aria-hidden="true">↗</span><span class="sr-only"> on Google Forms, opens in a new tab</span></a></p></aside>
      {{ close|safe }}
      {{ related_markup|safe }}
    </div>
