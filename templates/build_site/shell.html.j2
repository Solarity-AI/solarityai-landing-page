{#- email_off keeps Cloudflare Email Address Obfuscation from rewriting mailto links and visible addresses,
    so the domain serves exactly what dist/ contains. Preloading the display font everywhere adds no Home LCP
    cost with font-display optional (2855 vs 2857 ms measured in P2). -#}
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ full_title }}</title><meta name="description" content="{{ desc }}"><meta name="robots" content="{{ robots|safe }}"><meta name="referrer" content="strict-origin-when-cross-origin"><meta name="theme-color" content="#0f0d0b"><meta name="color-scheme" content="dark">{% if app_store_id %}<meta name="apple-itunes-app" content="app-id={{ app_store_id }}">{% endif %}<link rel="canonical" href="{{ url|safe }}"><meta property="og:type" content="website"><meta property="og:title" content="{{ full_title }}"><meta property="og:locale" content="en_US"><meta property="og:description" content="{{ desc }}"><meta property="og:url" content="{{ url|safe }}"><meta property="og:image" content="{{ origin|safe }}/assets/{{ social_image|safe }}"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:alt" content="{{ social_alt }}"><meta property="og:site_name" content="Solarity AI"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="{{ origin|safe }}/assets/{{ social_image|safe }}"><link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48"><link rel="icon" href="/assets/icons/icon-192.png" type="image/png" sizes="192x192"><link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png"><link rel="icon" href="/assets/brand/solarity-sun-48.9bc99afc73e8.webp" type="image/webp" sizes="48x48"><link rel="preload" href="{{ font_url|safe }}" as="font" type="font/woff2" crossorigin><link rel="preload" href="{{ display_font_url|safe }}" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/assets/presentation.css"><script src="/assets/site.js" defer></script></head>
<body data-page="{{ path|safe }}"><!--email_off--><a class="skip-link" href="#main">Skip to content</a>{{ header|safe }}
<main id="main" tabindex="-1">{{ body|safe }}</main><dialog id="image-dialog" aria-labelledby="image-dialog-title"><div class="image-dialog-bar"><h2 id="image-dialog-title">App screenshot</h2><button type="button" id="image-dialog-close">Close preview <span aria-hidden="true">×</span></button></div><img id="image-dialog-image" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="" width="600" height="1298"><div class="image-dialog-nav" id="image-dialog-nav" hidden><button type="button" id="image-dialog-prev"><span aria-hidden="true">←</span> Previous<span class="sr-only"> screenshot</span></button><span id="image-dialog-count" aria-live="polite"></span><button type="button" id="image-dialog-next">Next<span class="sr-only"> screenshot</span> <span aria-hidden="true">→</span></button></div><p id="image-dialog-caption" class="caption">{{ provenance|safe }}</p></dialog>{{ footer|safe }}<script type="application/ld+json">{{ json_ld|safe }}</script><!--/email_off--></body></html>
